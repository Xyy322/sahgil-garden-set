{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "src/utils/firebase/firestore.rules"
  },
  "storage": {
    "rules": "src/utils/firebase/storage.rules"
  }
}