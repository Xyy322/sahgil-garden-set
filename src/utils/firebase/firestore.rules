rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated()
        && userDoc().data.role == "admin";
    }

    function isOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId;
    }

    function isValidOrderStatus(status) {
      return status in [
        "Pending", "pending",
        "Processing", "processing",
        "Shipped", "shipped",
        "Delivered", "delivered",
        "Cancelled", "cancelled",
        "Canceled", "canceled"
      ];
    }


    function isValidNotificationType(type) {
      return type in ["order", "appointment", "inquiry"];
    }

    function isValidRelatedCollection(collectionName) {
      return collectionName in ["orders", "appointments", "inquiries"];
    }

    function isValidNotificationPayload() {
      return request.resource.data.keys().hasOnly([
          "userId",
          "title",
          "message",
          "type",
          "statusRefId",
          "relatedId",
          "relatedCollection",
          "read",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && isValidNotificationType(request.resource.data.type)
        && request.resource.data.statusRefId is string
        && request.resource.data.statusRefId.size() > 0
        && request.resource.data.relatedId is string
        && request.resource.data.relatedId == request.resource.data.statusRefId
        && request.resource.data.relatedCollection is string
        && isValidRelatedCollection(request.resource.data.relatedCollection)
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isAdminNotificationForOwnedOrder() {
      return request.resource.data.userId == "admin"
        && request.resource.data.type == "order"
        && request.resource.data.relatedCollection == "orders"
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.statusRefId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.statusRefId)).data.userId == request.auth.uid;
    }

    function isAdminNotificationForOwnedAppointment() {
      return request.resource.data.userId == "admin"
        && request.resource.data.type == "appointment"
        && request.resource.data.relatedCollection == "appointments"
        && exists(/databases/$(database)/documents/appointments/$(request.resource.data.statusRefId))
        && get(/databases/$(database)/documents/appointments/$(request.resource.data.statusRefId)).data.userId == request.auth.uid;
    }

    function isAdminNotificationForOwnedInquiry() {
      return request.resource.data.userId == "admin"
        && request.resource.data.type == "inquiry"
        && request.resource.data.relatedCollection == "inquiries"
        && exists(/databases/$(database)/documents/inquiries/$(request.resource.data.statusRefId))
        && get(/databases/$(database)/documents/inquiries/$(request.resource.data.statusRefId)).data.userId == request.auth.uid;
    }

    function isValidSelfNotification() {
      return request.resource.data.userId == request.auth.uid;
    }

    function isValidAdminNotificationTarget() {
      return isAdminNotificationForOwnedOrder()
        || isAdminNotificationForOwnedAppointment()
        || isAdminNotificationForOwnedInquiry();
    }

    function isOptionalValidDeliveryFee() {
      return !("deliveryFee" in request.resource.data)
        || request.resource.data.deliveryFee == null
        || (
          request.resource.data.deliveryFee is number
          && request.resource.data.deliveryFee >= 0
          && request.resource.data.deliveryFee <= 100000
        );
    }

    function isOptionalValidFinalTotal() {
      return !("finalTotal" in request.resource.data)
        || request.resource.data.finalTotal == null
        || (
          request.resource.data.finalTotal is number
          && request.resource.data.finalTotal >= 0
        );
    }


    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == "customer";

      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

        match /orders/{orderId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          "userId",
          "orderNumber",
          "customerName",
          "customerEmail",
          "customerPhone",
          "address",
          "items",
          "shippingInfo",
          "productSubtotal",
          "deliveryFee",
          "finalTotal",
          "total",
          "paymentMethod",
          "deliveryNote",
          "status",
          "createdAt",
          "updatedAt"
        ])

        // Ownership
        && request.resource.data.userId == request.auth.uid

        // Order identity
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() >= 5
        && request.resource.data.orderNumber.size() <= 40

        // Customer details
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 1
        && request.resource.data.customerName.size() <= 120

        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail == request.auth.token.email

        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 0
        && request.resource.data.customerPhone.size() <= 30

        && request.resource.data.address is string
        && request.resource.data.address.size() > 5
        && request.resource.data.address.size() <= 500

        // Cart limits
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50

        // Shipping info
        && request.resource.data.shippingInfo is map
        && request.resource.data.shippingInfo.keys().hasOnly([
          "fullName",
          "phone",
          "address",
          "city",
          "postalCode"
        ])
        && request.resource.data.shippingInfo.fullName is string
        && request.resource.data.shippingInfo.fullName.size() > 1
        && request.resource.data.shippingInfo.fullName.size() <= 120
        && request.resource.data.shippingInfo.phone is string
        && request.resource.data.shippingInfo.phone.size() > 0
        && request.resource.data.shippingInfo.phone.size() <= 30
        && request.resource.data.shippingInfo.address is string
        && request.resource.data.shippingInfo.address.size() > 5
        && request.resource.data.shippingInfo.address.size() <= 300
        && request.resource.data.shippingInfo.city is string
        && request.resource.data.shippingInfo.city.size() > 0
        && request.resource.data.shippingInfo.city.size() <= 120
        && request.resource.data.shippingInfo.postalCode is string
        && request.resource.data.shippingInfo.postalCode.size() > 0
        && request.resource.data.shippingInfo.postalCode.size() <= 20

        // Amounts
        && request.resource.data.productSubtotal is number
        && request.resource.data.productSubtotal > 0
        && request.resource.data.productSubtotal <= 10000000

        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total == request.resource.data.productSubtotal

        // Delivery fee must be admin-confirmed later, not customer-created
        && request.resource.data.deliveryFee == null
        && request.resource.data.finalTotal == null

        // Payment and status
        && request.resource.data.paymentMethod == "Cash on Delivery"
        && request.resource.data.deliveryNote is string
        && request.resource.data.deliveryNote.size() > 0
        && request.resource.data.deliveryNote.size() <= 300

        // Customers may only create new orders as Pending.
        // They must not create Delivered, Cancelled, Processing, or Shipped orders.
        && request.resource.data.status in ["Pending", "pending"]

        // Timestamps
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow read: if isAuthenticated()
        && (
          isAdmin() ||
          resource.data.userId == request.auth.uid
        );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt", "deliveryFee", "finalTotal"])
        && isValidOrderStatus(request.resource.data.status)
        && request.resource.data.updatedAt is timestamp
        && isOptionalValidDeliveryFee()
        && isOptionalValidFinalTotal();

      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          "userId",
          "customerName",
          "customerEmail",
          "customerPhone",
          "customerAddress",
          "address",
          "date",
          "time",
          "serviceType",
          "description",
          "status",
          "lockDates",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 1
        && request.resource.data.customerEmail is string
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() > 0
        && request.resource.data.customerAddress is string
        && request.resource.data.customerAddress.size() > 5
        && request.resource.data.address is string
        && request.resource.data.address.size() > 5
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.time is string
        && request.resource.data.time.size() == 5
        && request.resource.data.serviceType == "landscaping-consultation"
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.status == "pending"
        && request.resource.data.lockDates is list
        && request.resource.data.lockDates.size() == 1
        && request.resource.data.lockDates[0] == request.resource.data.date
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow read: if isAuthenticated()
        && (
          isAdmin() ||
          resource.data.userId == request.auth.uid
        );

      allow update: if isAdmin()
  || (
    resource.data.userId == request.auth.uid
    && resource.data.status == "pending"
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.status == "cancelled"
    && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(["status", "updatedAt"])
  );

      allow delete: if false;
    }

    match /appointmentLocks/{lockId} {
      allow read: if isAuthenticated();

      allow create: if isAdmin()
        || (
          isAuthenticated()
          && !exists(/databases/$(database)/documents/appointmentLocks/$(lockId))
          && request.resource.data.keys().hasOnly([
            "date",
            "appointmentId",
            "userId",
            "status",
            "createdAt",
            "updatedAt"
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.date == lockId
          && request.resource.data.appointmentId is string
          && request.resource.data.appointmentId.size() > 0
          && request.resource.data.status == "pending"
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
        );

      allow update: if isAdmin();

      allow delete: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
          && resource.data.status == "pending"
        );
    }

    match /inquiries/{inquiryId} {
      allow create: if (
        isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerType == "registered"
        && request.resource.data.adminRead == false
        && request.resource.data.adminReadAt == null
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.inquiryType is string
        && request.resource.data.message is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.email.size() > 3
        && request.resource.data.phone.size() > 0
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
      ) || (
        !isAuthenticated()
        && request.resource.data.userId == ""
        && request.resource.data.customerType == "guest"
        && request.resource.data.adminRead == false
        && request.resource.data.adminReadAt == null
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.inquiryType is string
        && request.resource.data.message is string
        && request.resource.data.fullName.size() > 1
        && request.resource.data.email.size() > 3
        && request.resource.data.phone.size() > 0
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
      );

      allow read: if isAuthenticated()
        && (
          isAdmin() ||
          resource.data.userId == request.auth.uid
        );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["adminRead", "adminReadAt", "updatedAt"]);

      allow delete: if false;
    }

        match /reviews/{reviewId} {
      allow create: if request.resource.data.keys().hasOnly([
          "displayName",
          "isAnonymous",
          "rating",
          "message",
          "status",
          "createdAt",
          "updatedAt",
          "approvedAt",
          "declinedAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80

        && request.resource.data.isAnonymous is bool
        && (
          (
            request.resource.data.isAnonymous == true
            && request.resource.data.displayName == "Anonymous"
          )
          ||
          (
            request.resource.data.isAnonymous == false
            && request.resource.data.displayName != "Anonymous"
          )
        )

        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5

        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 300

        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.approvedAt == null
        && request.resource.data.declinedAt == null;

      allow read: if isAdmin()
        || resource.data.status == "approved";

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "updatedAt", "approvedAt", "declinedAt"])
        && request.resource.data.status in ["pending", "approved", "declined"]
        && request.resource.data.updatedAt is timestamp
        && (
          request.resource.data.approvedAt == null
          || request.resource.data.approvedAt is timestamp
        )
        && (
          request.resource.data.declinedAt == null
          || request.resource.data.declinedAt is timestamp
        );

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if isAuthenticated()
        && isValidNotificationPayload()
        && (
          isAdmin() ||
          isValidSelfNotification() ||
          isValidAdminNotificationTarget()
        );

      allow read: if isAuthenticated()
        && (
          isAdmin() ||
          resource.data.userId == request.auth.uid
        );

      allow update: if isAuthenticated()
        && (
          isAdmin() ||
          resource.data.userId == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["read", "updatedAt"]);

      allow delete: if false;
    }
  }
}